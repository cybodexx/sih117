# === PostgreSQL (fields of Settings in backend/core/config.py — extra keys are FORBIDDEN) ===
# DATABASE_URL=postgresql+asyncpg://aegis:aegis@postgres:5432/aegis_wb
DATABASE_URL=postgresql+asyncpg://aegis:CHANGE_ME_IN_PRODUCTION@postgres:5432/aegis_wb

# === Qdrant ===
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=aegis_bge_m3_1024

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Sentinel ===
SENTINEL_URL=http://sentinel:8001

# === Ollama ===
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
VISION_MODEL=llava:7b-v1.6
EMBED_MODEL=bge-m3
EMBED_DIM=1024
OLLAMA_TIMEOUT_S=60
OLLAMA_KEEP_ALIVE=-1

# === JWT ===
JWT_PRIVATE_KEY_PATH=/data/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/data/keys/jwt_public.pem
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_H=8

# === Upload ===
MAX_UPLOAD_MB=200
VAULT_PATH=/data/vault

# === RAG ===
CHUNK_TARGET_TOKENS=512
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
ENABLE_RERANKER=true
ENABLE_OCR=true
ENABLE_VISION=true

# === Agent ===
MAX_AGENT_ITERATIONS=3
TURN_DEADLINE_S=60
RECURSION_LIMIT=12

# === App ===
# AIRGAP_MODE=false
APP_ENV=development
LOG_LEVEL=INFO